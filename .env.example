# DZ Car Rental Finder local configuration
# No paid API keys are required. All collection runs locally.
DZ_HOST=127.0.0.1
DZ_PORT=8000
DZ_DB_PATH=data/processed/dz_car_rental.db
DZ_LOG_LEVEL=INFO
DZ_DEFAULT_RATE_LIMIT_SECONDS=1.5
DZ_USER_AGENT=DZCarRentalFinder/1.0 (+local-research-tool)
APP_URL=http://127.0.0.1:3000
